PORT=4000                        # API port (bound to 127.0.0.1 only)
SMTP_HOST=                        # SMTP server host (empty = email disabled, fails lazily)
SMTP_PORT=587                     # SMTP port (465 = implicit TLS)
SMTP_USER=                        # SMTP username
SMTP_PASS=                        # SMTP password / app token
CONTACT_TO_EMAIL=                 # Inbox that receives contact-form notifications
CONTACT_FROM_EMAIL=               # From address for firm notifications
NO_REPLY_EMAIL=                   # Sender of the client acknowledgement (falls back to CONTACT_FROM_EMAIL)
FIRM_NAME=                        # Display name in the acknowledgement (default: Mwaura Muroki Associates & Advocates)
TURNSTILE_SECRET_KEY=             # Cloudflare Turnstile secret (empty = verification off, dev only)
MAX_TOTAL_UPLOAD_MB=10            # Max upload size in MB
